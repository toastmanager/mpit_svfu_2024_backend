model Place {
    id Int @id @default(autoincrement())

    title          String
    type           PlaceType
    description    String
    locationName   String                                @map("location_name")
    redirectUrl    String?                               @map("redirect_url")
    activity       Activity
    ageRestriction Int                                   @default(0) @map("age_restriction")
    price          Decimal                               @db.Money
    prevPrice      Decimal?                              @default(0) @map("prev_price") @db.Money
    isPublished    Boolean                               @default(false) @map("is_published")
    onModeration   Boolean                               @default(false) @map("on_moderation")
    start          DateTime?
    end            DateTime?
    imageKeys      String[]                              @map("image_keys")
    coords         Unsupported("geometry(Point, 4326)")?
    address        String?
    contacts       String[]

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    authorId Int  @map("author_id")
    author   User @relation(fields: [authorId], references: [id])

    routes  Route[]
    reviews PlaceReview[]

    @@index([coords], name: "location_idx", type: Gist)
    @@map("places")
}

enum PlaceType {
    LANDMARK
    RESTAURANT
    CAFE
    BEACH
    BAR
    MOVIE_THEATER
    NATURE
    MUSEUM
    CONCERT
    HOTEL
    MOTEL
    HOSTEL
}

enum Activity {
    SMALL
    MEDIUM
    ADVANCED
    HIGH
}
